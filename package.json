{
  "name": "portfolio-v2",
  "version": "5.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--trace-deprecation' next dev",
    "build": "next build",
    "start": "next start",
    "lint": "NODE_OPTIONS='--max-old-space-size=8192' eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "node --test 'src/**/*.test.ts'",
    "images:to-webp": "node scripts/convert-images-to-webp.mjs",
    "peaks:generate": "node --env-file-if-exists=.env.local scripts/generate-track-peaks.mjs",
    "db:generate": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit migrate",
    "db:studio": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/cloudfront-signer": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@mdx-js/loader": "^3.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@next/bundle-analyzer": "^16.3.0",
    "@next/mdx": "^16.3.0",
    "@sentry/nextjs": "^10.70.0",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "github-slugger": "^2.0.0",
    "mermaid": "^11.16.1",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-github-calendar": "^5.0.8",
    "react-hot-toast": "^2.6.0",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.19.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  }
}
