{
  "name": "portfolio-v2",
  "version": "5.1.0",
  "packageManager": "pnpm@12.4.1",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--trace-deprecation' next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "images:to-webp": "node scripts/convert-images-to-webp.mjs",
    "peaks:generate": "node --env-file-if-exists=.env.local scripts/generate-track-peaks.mjs",
    "db:generate": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit migrate",
    "db:studio": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/cloudfront-signer": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@mdx-js/loader": "^3.1.1",
    "@neondatabase/serverless": "^1.2.1",
    "@next/bundle-analyzer": "^16.4.6",
    "@next/mdx": "^16.4.6",
    "@sentry/nextjs": "^11.12.0",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "drizzle-orm": "^0.45.4",
    "github-slugger": "^2.0.0",
    "mermaid": "^12.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-github-calendar": "^5.0.9",
    "react-hot-toast": "^2.6.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.38.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
